{
  "name": "astolia-collab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Creator collab add-on: takes a creator from possible collab to usable tagged footage in the editors' library, and closes the loop.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "vue-tsc --noEmit",
    "fixtures": "node scripts/build-fixtures.mjs",
    "fixtures:verify": "node scripts/verify-fixtures.mjs",
    "seed": "node scripts/build-seed.mjs"
  },
  "dependencies": {
    "pinia": "^2.2.8",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "fake-indexeddb": "^6.0.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.1.10"
  }
}
